  { name: "Renault", logo: L + "renault.png", href: P + "renault-zoe/" },
  { name: "Expo 2020 Dubai", logo: L + "expo-2020-dubai.png", href: P + "expo-2020-story/" },
  { name: "Dubai Tourism", logo: L + "dubai-tourism.png", href: P + "dubai-business-events/" },
  { name: "Dubai Culture", logo: L + "dubai-culture.png" },
