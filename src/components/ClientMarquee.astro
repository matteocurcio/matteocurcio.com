  { name: "Cowra Tourism", logo: L + "cowra-tourism.png", href: P + "cowra/" },
  { name: "Sharjah Book Authority", logo: L + "sharjah-book-authority.png", href: P + "welcome-to-sharjah/" },
];

const key = (logo: string) => logo.split("/").pop()!.replace(".png", "");

// Rendered twice so translating the track by exactly -50% lands on an identical
// item and the loop is seamless. The second pass is hidden from assistive tech.
---

<section class="client-marquee" aria-label="Selected clients">
  <p class="client-marquee-label">Selected clients</p>
  <div class="client-marquee-viewport">
    <div class="client-marquee-track">
      {[false, true].map((isClone) => (
        <ul class="client-marquee-list" aria-hidden={isClone ? "true" : undefined}>
          {clients.map((client) => {
            const inner = client.logo ? (
              <img
                src={client.logo}
                alt={client.name}
                loading="eager"
                decoding="sync"
                width={DIMS[key(client.logo)]?.[0]}
                height={DIMS[key(client.logo)]?.[1]}
              />
            ) : (
              <span>{client.name}</span>
            );
            return (
              <li class={client.logo ? "has-logo" : undefined}>
                {client.href ? (
                  <a href={client.href} tabindex={isClone ? -1 : undefined} title={client.name}>
                    {inner}
                  </a>
                ) : (
                  inner
                )}
              </li>
            );
          })}
        </ul>
      ))}
    </div>
  </div>
</section>
