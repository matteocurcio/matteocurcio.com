---
interface Props {
  subject?: string;
}

const { subject = "Services enquiry" } = Astro.props;
---

<section class="services-enquiry" id="enquiry" aria-label="Services enquiry form">
  <div class="services-enquiry-grid">
    <form class="services-form" data-services-form data-services-subject={subject} novalidate>
      <p class="services-form-intro">
        I am available in person across Melbourne or remotely, depending on project needs, timeline, and workflow.
      </p>
      <div class="services-form-grid">
        <label>
          Name
          <input type="text" name="name" autocomplete="name" maxlength="80" required />
        </label>
        <label>
          Email
          <input type="email" name="email" autocomplete="email" maxlength="120" required />
        </label>
      </div>
      <label>
        Message
        <textarea
          name="message"
          rows="6"
          maxlength="2200"
          placeholder="Share what you need."
          required
        ></textarea>
      </label>
      <label class="hp-field" aria-hidden="true">
        Website
        <input type="text" name="website" autocomplete="off" tabindex="-1" />
      </label>
      <input type="hidden" name="formStartedAt" data-form-started-at />
      <div class="services-form-actions">
        <button type="submit" class="services-submit">Send enquiry</button>
        <p class="services-form-note" data-form-note aria-live="polite"></p>
      </div>
    </form>

    <aside class="services-enquiry-panel" aria-label="How projects usually begin">
      <div class="services-enquiry-panel-block">
        <p class="services-enquiry-eyebrow">How projects usually start</p>
        <h2>You do not need the whole brief solved yet.</h2>
        <p>
          A clear first email is enough. Scope, timeline, where the friction is, and what has to land well.
          We can shape the rest from there.
        </p>
      </div>

      <div class="services-enquiry-panel-block services-enquiry-panel-split">
        <div>
          <p class="services-enquiry-minihead">Typical entry points</p>
          <p class="services-enquiry-list">
            A project needs finishing fast without losing taste. An installation or presentation has to become
            technically reliable. A workflow is working, but only just.
          </p>
        </div>
        <div>
          <p class="services-enquiry-minihead">Working modes</p>
          <p class="services-enquiry-list">
            Melbourne-based in person when the room matters. Remote for reviews, consulting, and delivery
            support. Short interventions or longer project involvement.
          </p>
        </div>
      </div>
    </aside>
  </div>
</section>

<script is:inline>
  const forms = document.querySelectorAll("[data-services-form]");
  const THROTTLE_MS = 60000;
  const MIN_FILL_MS = 4000;
  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const LAST_SUBMIT_KEY = "mc_services_last_submit";
  const FORM_ENDPOINT = "https://formsubmit.co/ajax/hello@matteocurcio.com";

  forms.forEach((form) => {
    const formNote = form.querySelector("[data-form-note]");
    const startedAtInput = form.querySelector("[data-form-started-at]");

    if (startedAtInput instanceof HTMLInputElement) {
      startedAtInput.value = String(Date.now());
    }

    if (!(form instanceof HTMLFormElement)) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const now = Date.now();
      const lastSubmit = Number(window.localStorage.getItem(LAST_SUBMIT_KEY) || "0");
      if (lastSubmit && now - lastSubmit < THROTTLE_MS) {
        if (formNote) {
          formNote.textContent = "Please wait a minute before sending another enquiry.";
        }
        return;
      }

      const formData = new FormData(form);
      const website = String(formData.get("website") || "").trim();
      if (website.length > 0) {
        if (formNote) {
          formNote.textContent = "Unable to send this enquiry.";
        }
        return;
      }

      const startedAt = Number(formData.get("formStartedAt") || "0");
      if (!startedAt || now - startedAt < MIN_FILL_MS) {
        if (formNote) {
          formNote.textContent = "Please take a few seconds to complete the form.";
        }
        return;
      }

      const name = String(formData.get("name") || "").trim();
      const email = String(formData.get("email") || "").trim();
      const message = String(formData.get("message") || "").trim();

      if (!name || !EMAIL_REGEX.test(email) || message.length === 0 || message.length > 2200) {
        if (formNote) {
          formNote.textContent = "Please complete all fields correctly before sending.";
        }
        return;
      }

      if (formNote) {
        formNote.textContent = "Sending enquiry...";
      }

      const submitButton = form.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        const response = await fetch(FORM_ENDPOINT, {
          method: "POST",
          headers: {
            Accept: "application/json"
          },
          body: new URLSearchParams({
            name,
            email,
            message,
            _subject: form.dataset.servicesSubject || "Services enquiry",
            _template: "table",
            _honey: website
          })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok || (payload && payload.success === "false")) {
          throw new Error("Form submission failed.");
        }

        window.localStorage.setItem(LAST_SUBMIT_KEY, String(now));
        form.reset();
        if (startedAtInput instanceof HTMLInputElement) {
          startedAtInput.value = String(Date.now());
        }
        if (formNote) {
          formNote.textContent = "Enquiry sent. Thank you.";
        }
      } catch (error) {
        if (formNote) {
          formNote.textContent = "Unable to send right now. Please try again shortly.";
        }
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  });
</script>
