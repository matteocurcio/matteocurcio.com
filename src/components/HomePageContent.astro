---
import { CONTACT_MAILTO } from "../config/site";
import { getResolvedWorks } from "../lib/works";
import ClientMarquee from "./ClientMarquee.astro";

// The carousel pool: every work that has a moving preview, so each slide can
// play on hover. Order is fixed at build time; the entry point is randomised
// client-side so the reel doesn't open on the same project every visit.
const carouselWorks = (await getResolvedWorks()).filter((item) => Boolean(item.video));

// Rendered twice so the track can wrap seamlessly: once scrolling passes the
// halfway mark the script snaps back by exactly half a track, which lands on an
// identical slide. Clones are hidden from assistive tech and tab order.
const carouselLoop = [
  ...carouselWorks.map((item) => ({ item, isClone: false })),
  ...carouselWorks.map((item) => ({ item, isClone: true }))
];

const serviceLanes = [
  {
    title: "Colour, Online Editing & Finishing",
    body: "Online editing, colour grading, finishing, motion cleanup, and final delivery for commercial and branded post-production.",
    href: "/colour-grading/"
  },
  {
    title: "Workflow & Infrastructure",
    body: "Process design, the hardware and software I build to fix specific problems, and the security thinking underneath both.",
    href: "/workflow/"
  },
  {
    title: "Coaching",
    body: "From tutoring Adobe at RMIT to one-on-one coaching: Resolve and production workflows taught from real constraints, not tutorial theatre.",
    href: "/tutoring/"
  },
  {
    title: "Music",
    body: "Original composition, sync, and score for film, television, and advertising as one half of Grammy-nominated Musetta.",
    href: "/music/"
  }
];

---

<section class="home-hero" aria-label="Homepage hero" data-home-hero>
  <video
    class="home-hero-video"
    data-home-hero-video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/assets/projects/gigabyte-a-gentle-giant/thumbnail_a_gentle_giant.webp"
  >
    <source src="/assets/projects/gigabyte-a-gentle-giant/video_a_gentle_giant.mp4" type="video/mp4" />
  </video>
  <div class="home-hero-overlay"></div>
  <canvas class="home-hero-code-canvas" aria-hidden="true" data-home-hero-code-canvas></canvas>
  <div class="home-hero-inner shell">
    <p class="home-kicker">Melbourne / Remote · For studios, producers & agencies</p>
    <h1 class="home-hero-headline">Colour, finishing and delivery for work that has to land.</h1>
    <p class="home-hero-literal">
      Matteo Curcio is a Melbourne-based online editor, colourist, finishing artist, and workflow consultant for commercial, branded, and agency post-production.
    </p>
    <div class="home-hero-actions">
      <a class="home-button home-button-primary" href={CONTACT_MAILTO}>Start a project</a>
      <a class="home-button" href="/works/">See the work</a>
    </div>
  </div>
</section>

<section class="home-section section" id="selected-work">
  <div class="home-section-head home-carousel-head">
    <p class="kicker">Selected Work</p>
    <h2>Commercial colour, finishing and motion.</h2>
  </div>

  <div class="home-carousel" data-work-carousel>
    <div class="home-carousel-track" data-work-carousel-track>
      {carouselLoop.map(({ item, isClone }) => (
        <a
          class="home-feature-card home-carousel-slide"
          href={item.href}
          aria-hidden={isClone ? "true" : undefined}
          tabindex={isClone ? -1 : undefined}
        >
          <div class="home-feature-media" data-hover-preview="true">
            <img src={item.image} alt={item.title} loading="lazy" />
            <video
              class="home-feature-preview"
              src={item.video}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            />
            <div class="home-feature-overlay">
              <p class="home-feature-title">{item.title}</p>
              <p class="home-feature-meta">{item.meta}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>

  <ClientMarquee />
</section>

<section class="home-section section">
  <div class="home-editorial">
    <div class="home-lane-stack">
      {serviceLanes.map((lane) => (
        <a class="home-lane" href={lane.href}>
          <h3>{lane.title}</h3>
          <div class="home-lane-body">
            <p>{lane.body}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="home-editorial-copy panel">
      <h2>Form equals function.</h2>
      <p>
        A grade is a run of judgement calls about what the picture is meant to feel like. Where the eye goes first. Whether skin reads as a person or a product. Whether the brand's blue survives contact with the actual footage. Those decisions are the work, and they don't come from a preset, they come from having made them a few thousand times and being willing to argue for them. For a focused version of that work, see <a href="/colour-grading/">colour grading</a>; for the broader delivery pipeline, see <a href="/finishing/">online editing and finishing</a>.
      </p>
      <p>
        The other half is less visible and just as decisive: whether that look survives being re-cut, re-framed and re-versioned across every deliverable the campaign ships. Something can be beautifully made and still be a problem if the pipeline behind it is guesswork. When both halves hold, the work holds, through revisions, under pressure, and long after the deadline that made it feel urgent.
      </p>
    </div>
  </div>
</section>

<section class="home-section section">
  <div class="home-cta">
    <div>
      <p class="kicker">Start Here</p>
      <h2>Post-house quality, without the post house.</h2>
      <p>
        Producers, agencies, and studios come to me when the work still has to be excellent and they'd rather keep things close than route everything through a bigger machine.
      </p>
    </div>
    <div class="home-cta-actions">
      <a class="home-button home-button-primary" href={CONTACT_MAILTO}>Start a project</a>
      <a class="home-button" href="/services/">View services</a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const carousel = document.querySelector("[data-work-carousel]");
    const track = document.querySelector("[data-work-carousel-track]");
    if (!carousel || !track) return;

    const slides = Array.from(track.querySelectorAll(".home-carousel-slide"));
    if (slides.length < 2) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const step = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
      return slides[0].getBoundingClientRect().width + gap;
    };

    // The track holds two identical copies of the pool, so scrollLeft and
    // scrollLeft - half render the same thing. Rewinding by half while the
    // track is at rest is therefore invisible, and the reel never runs out.
    // Measured as one copy's worth of steps, not scrollWidth / 2: the track has
    // one fewer gap than slides, so scrollWidth / 2 is half a gap short and the
    // wrap would drift a few pixels every lap.
    const half = () => (slides.length / 2) * step();
    const wrap = () => {
      if (track.scrollLeft >= half()) track.scrollLeft -= half();
      else if (track.scrollLeft <= 0) track.scrollLeft += half();
    };

    // Open on a different project each visit rather than always the first.
    track.scrollLeft = Math.floor(Math.random() * (slides.length / 2)) * step();

    const advance = (direction) => {
      wrap();
      track.scrollBy({ left: step() * direction, behavior: reduceMotion ? "auto" : "smooth" });
    };

    // Also rewind after a manual trackpad or touch scroll settles.
    let settle = 0;
    track.addEventListener("scroll", () => {
      window.clearTimeout(settle);
      settle = window.setTimeout(wrap, 180);
    });

    if (reduceMotion) return;

    let timer = window.setInterval(() => advance(1), 4500);
    const pause = () => window.clearInterval(timer);
    const resume = () => {
      pause();
      timer = window.setInterval(() => advance(1), 4500);
    };

    carousel.addEventListener("pointerenter", pause);
    carousel.addEventListener("pointerleave", resume);
    carousel.addEventListener("focusin", pause);
    carousel.addEventListener("focusout", resume);
    document.addEventListener("visibilitychange", () => (document.hidden ? pause() : resume()));
  })();

  const homeHero = document.querySelector("[data-home-hero]");
  const heroVideo = document.querySelector("[data-home-hero-video]");
  const heroCodeCanvas = document.querySelector("[data-home-hero-code-canvas]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (homeHero && heroVideo instanceof HTMLVideoElement && heroCodeCanvas instanceof HTMLCanvasElement && !prefersReducedMotion) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const ctx = heroCodeCanvas.getContext("2d");
    const sampleCanvas = document.createElement("canvas");
    const sampleCtx = sampleCanvas.getContext("2d", { willReadFrequently: true });
    const revealPoints = [];
    const codeSource = [
      "grade=node(balance_lift,gamma,gain) ",
      "cst=input(logc3):output(bt709) ",
      "python:def match_shot(frame):return preserve_texture(frame) ",
      "vec3 colour=texture(scene,uv).rgb; ",
      "halation=strength*softclip(highlights); ",
      "resolve.timeline.render(deliver='prores'); ",
      "gl_FragColor=vec4(contrast(sat(colour)),1.0); ",
      "curve=filmic(shoulder,toe,microcontrast); ",
      "matrix=bt709 transfer=bt709 primaries=bt709 ",
      "grain=temporal_subtle(edge_safe=True) "
    ].join("");

    let fontSize = 15;
    let charWidth = 9;
    let lineHeight = 18;
    let columns = 0;
    let rows = 0;
    let scrollRow = 0;
    let lastScrollAt = performance.now();
    let resizeFrame = 0;

    const measureGrid = () => {
      if (!ctx) return;
      const rect = homeHero.getBoundingClientRect();
      heroCodeCanvas.width = Math.max(1, Math.floor(rect.width * dpr));
      heroCodeCanvas.height = Math.max(1, Math.floor(rect.height * dpr));
      heroCodeCanvas.style.width = `${rect.width}px`;
      heroCodeCanvas.style.height = `${rect.height}px`;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      fontSize = Math.max(11, Math.min(16, rect.width / 108));
      lineHeight = Math.round(fontSize * 1.28);
      ctx.font = `500 ${fontSize}px "IBM Plex Mono", "SFMono-Regular", "SF Mono", "Menlo", monospace`;
      charWidth = Math.max(7, Math.ceil(ctx.measureText("0").width));
      columns = Math.ceil(rect.width / charWidth) + 2;
      rows = Math.ceil(rect.height / lineHeight) + 2;
      sampleCanvas.width = columns;
      sampleCanvas.height = rows;
    };

    const addRevealPoint = (x, y, radius) => {
      revealPoints.push({ x, y, radius, life: 1 });
      if (revealPoints.length > 120) revealPoints.shift();
    };

    const pointerMove = (event) => {
      const rect = homeHero.getBoundingClientRect();
      addRevealPoint(event.clientX - rect.left, event.clientY - rect.top, 110);
      homeHero.classList.add("is-interactive");
    };

    const pointerLeave = () => {
      addRevealPoint(-9999, -9999, 0);
      homeHero.classList.remove("is-interactive");
    };

    const revealStrengthAt = (x, y) => {
      let strength = 0;
      for (let i = 0; i < revealPoints.length; i += 1) {
        const point = revealPoints[i];
        if (point.radius <= 0 || point.life <= 0) continue;
        const dx = x - point.x;
        const dy = y - point.y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        if (distance > point.radius) continue;
        const local = (1 - distance / point.radius) * point.life;
        if (local > strength) strength = local;
      }
      return strength;
    };

    const drawFrame = (now) => {
      requestAnimationFrame(drawFrame);
      if (!ctx || !sampleCtx) return;
      if (heroVideo.readyState < 2 || columns === 0 || rows === 0) return;

      if (now - lastScrollAt > 1000) {
        scrollRow = (scrollRow + 1) % 10000;
        lastScrollAt = now;
      }

      sampleCtx.clearRect(0, 0, sampleCanvas.width, sampleCanvas.height);
      sampleCtx.drawImage(heroVideo, 0, 0, sampleCanvas.width, sampleCanvas.height);
      const sampleData = sampleCtx.getImageData(0, 0, sampleCanvas.width, sampleCanvas.height).data;

      ctx.clearRect(0, 0, heroCodeCanvas.width, heroCodeCanvas.height);
      ctx.font = `500 ${fontSize}px "IBM Plex Mono", "SFMono-Regular", "SF Mono", "Menlo", monospace`;
      ctx.textBaseline = "top";

      for (let i = revealPoints.length - 1; i >= 0; i -= 1) {
        revealPoints[i].life -= 0.00135;
        revealPoints[i].radius += 0.035;
        if (revealPoints[i].life <= 0) {
          revealPoints.splice(i, 1);
        }
      }

      for (let row = 0; row < rows; row += 1) {
        const y = row * lineHeight;
        const sourceRowOffset = ((row + scrollRow) * 37) % codeSource.length;

        for (let col = 0; col < columns; col += 1) {
          const x = col * charWidth;
          const reveal = revealStrengthAt(x + charWidth * 0.5, y + lineHeight * 0.5);
          if (reveal < 0.015) continue;

          const sourceIndex = (sourceRowOffset + col) % codeSource.length;
          const char = codeSource[sourceIndex];
          const sampleIndex = ((row * sampleCanvas.width) + Math.min(col, sampleCanvas.width - 1)) * 4;
          const r = sampleData[sampleIndex] || 240;
          const g = sampleData[sampleIndex + 1] || 230;
          const b = sampleData[sampleIndex + 2] || 220;
          const luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
          const alpha = Math.min(0.88, reveal * (0.55 + luminance * 0.8));

          ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
          ctx.fillText(char, x, y);
        }
      }
    };

    const resize = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(measureGrid);
    };

    measureGrid();
    requestAnimationFrame(drawFrame);

    homeHero.addEventListener("pointermove", pointerMove);
    homeHero.addEventListener("pointerleave", pointerLeave);
    homeHero.addEventListener("pointerenter", () => homeHero.classList.add("is-interactive"));
    window.addEventListener("resize", resize);
  }
</script>
