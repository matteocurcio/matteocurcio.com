---
import { CONTACT_MAILTO, SITE_CONFIG } from "../config/site";
import { technicalPosts } from "../lib/posts";
import PostCard from "./PostCard.astro";

const latestPosts = technicalPosts.slice(0, 3);

const featuredWorks = [
  {
    href: "/projects/a-gentle-giant/",
    title: "A Gentle Giant",
    client: "Gigabyte",
    year: "2023",
    discipline: "Motion",
    image: "/assets/projects/gigabyte-a-gentle-giant/thumbnail_a_gentle_giant.webp",
    video: "/assets/projects/gigabyte-a-gentle-giant/thumbnail_a_gentle_giant.mp4"
  },
  {
    href: "/projects/amp/",
    title: "Quay Quarter",
    client: "AMP",
    year: "2023",
    discipline: "Motion",
    image: "/assets/projects/amp-quay-quarter/thumbnail_amp.webp",
    video: "/assets/projects/amp-quay-quarter/video_amp.mov"
  },
  {
    href: "/projects/merrie-melodies/",
    title: "Merrie Melodies",
    client: "Original music",
    year: "2022",
    discipline: "Music",
    image: "/assets/projects/music-merrie-melodies/thumbnail_merrie_melodies.webp"
  }
];

const serviceLanes = [
  {
    title: "Finishing",
    body: "Colour, editorial, motion graphics, and delivery for commercial and branded work that needs to hold together under pressure.",
    href: "/services"
  },
  {
    title: "Workflow",
    body: "Creative infrastructure, delivery systems, and process design for studios that are tired of avoidable chaos.",
    href: "/services"
  },
  {
    title: "Security",
    body: "A systems-first move into cybersecurity, informed by infrastructure practice, workflow auditing, and the habit of finding weak links early.",
    href: "/security"
  },
  {
    title: "Coaching",
    body: "Resolve, Adobe, and production workflows taught from real constraints, not tutorial theatre.",
    href: "/tutoring"
  }
];

const professionalContext =
  "Twenty years across finishing, immersive media, music, workflow design, and increasingly security. The throughline is systems: how they behave, where they fail, and how to make them reliable under pressure.";

const proofSignals = [
  "ISC2 CC",
  "RMIT Cyber Security",
  "Grammy-nominated music collaboration",
  "Expo 2020 / UAE",
  "Melbourne / Remote"
];
---

<section class="home-hero" aria-label="Homepage hero" data-home-hero>
  <video
    class="home-hero-video"
    data-home-hero-video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/assets/projects/gigabyte-a-gentle-giant/thumbnail_a_gentle_giant.webp"
  >
    <source src="/assets/projects/gigabyte-a-gentle-giant/video_a_gentle_giant.mp4" type="video/mp4" />
  </video>
  <div class="home-hero-overlay"></div>
  <canvas class="home-hero-code-canvas" aria-hidden="true" data-home-hero-code-canvas></canvas>
  <div class="home-hero-inner shell">
    <p class="home-kicker">Melbourne / Remote · For studios, producers & agencies</p>
    <h1>The Ghost in the Machine.</h1>
    <p class="home-hero-copy">
      The aesthetic draws you in. The logic is why it stays. I work where both are true at once.
    </p>
    <div class="home-hero-actions">
      <a class="home-button" href="/works">View Projects</a>
      <a class="home-button" href="/services">How I work</a>
    </div>
  </div>
</section>

<section class="home-proof-strip section" aria-label="Professional context">
  <p class="home-context-line">{professionalContext}</p>
  <div class="credibility-strip">
    {proofSignals.map((item) => <span>{item}</span>)}
  </div>
</section>

<section class="home-section section" id="selected-work">
  <div class="home-section-head">
    <p class="kicker">Selected Work</p>
    <h2>Motion-first, but not motion-only.</h2>
    <p>
      The work moves across finishing, motion, immersive formats, editorial structure, and the systems underneath all of it.
    </p>
  </div>

  <div class="home-feature-grid">
    {featuredWorks.map((item) => (
      <a class="home-feature-card" href={item.href}>
        <div class="home-feature-media" data-hover-preview="true">
          <img src={item.image} alt={item.title} loading="lazy" />
          <video
            class="home-feature-preview"
            src={item.video}
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          />
          <div class="home-feature-overlay">
            <p class="home-feature-title">{item.title}</p>
            <p class="home-feature-meta">{item.client} · {item.year} · {item.discipline}</p>
          </div>
        </div>
      </a>
    ))}
  </div>

  <div class="home-inline-link">
    <a class="button-link" href="/works">Browse all projects</a>
  </div>
</section>

<section class="home-section section">
  <div class="home-editorial">
    <div class="home-editorial-copy panel">
      <p class="kicker">How I Work</p>
      <h2>Form equals function.</h2>
      <p>
        My work spans colour, finishing, motion, and editorial, the craft you'd expect from any post house. But a lot of what I actually do happens earlier, in the decisions most reels never mention: how a project is structured, where the files live, how the work survives three rounds of notes and a delivery spec that shifted on a Friday afternoon. Those choices are what keep a creative process from quietly coming apart once the schedule tightens.
      </p>
      <p>
        I care about both halves because they aren't really separable. Something can be beautifully made and still be a problem if the pipeline behind it is held together with guesswork. When the underlying process is solid, the work holds up: through revisions, under pressure, and well after the deadline that made it all feel urgent.
      </p>
    </div>

    <div class="home-lane-stack">
      {serviceLanes.map((lane) => (
        <a class="home-lane" href={lane.href}>
          <h3>{lane.title}</h3>
          <p>{lane.body}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="home-section section">
  <div class="home-section-head">
    <p class="kicker">Writing</p>
    <h2>Technical notes here, broader essays elsewhere.</h2>
    <p>
      The on-site blog stays focused on post-production, workflow, and technical practice. Cultural and broader essay writing lives separately on Substack.
    </p>
  </div>

  <div class="writing-destinations">
    <a class="writing-destination" href="/blog">
      <span>Technical Blog</span>
      <strong>Workflow, tools, colour, infrastructure, and practical post-production systems.</strong>
    </a>
    <a class="writing-destination" href={SITE_CONFIG.social.substack} target="_blank" rel="noopener noreferrer">
      <span>Substack</span>
      <strong>Broader essays on culture, technology, media, and the stranger edges of the machine.</strong>
    </a>
  </div>

  <div class="blog-grid">
    {latestPosts.map((post) => (
      <PostCard
        slug={post.slug}
        title={post.title}
        date={post.date}
        excerpt={post.excerpt}
        cover={post.cover}
        coverAlt={post.coverAlt}
      />
    ))}
  </div>

  <div class="home-inline-link">
    <a class="button-link" href="/blog">Read the technical blog</a>
    <a class="button-link" href={SITE_CONFIG.social.substack} target="_blank" rel="noopener noreferrer">Read other writing on Substack</a>
  </div>
</section>

<section class="home-section section">
  <div class="home-cta">
    <div>
      <p class="kicker">Start Here</p>
      <h2>Post-house quality, without the post house.</h2>
      <p>
        Producers, agencies, and studios come to me when the work still has to be excellent and they'd rather keep things close than route everything through a bigger machine.
      </p>
    </div>
    <div class="home-cta-actions">
      <a class="home-button home-button-primary" href={CONTACT_MAILTO}>Start a project</a>
      <a class="home-button" href="/services">View services</a>
    </div>
  </div>
</section>

<script is:inline>
  const homeHero = document.querySelector("[data-home-hero]");
  const heroVideo = document.querySelector("[data-home-hero-video]");
  const heroCodeCanvas = document.querySelector("[data-home-hero-code-canvas]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (homeHero && heroVideo instanceof HTMLVideoElement && heroCodeCanvas instanceof HTMLCanvasElement && !prefersReducedMotion) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const ctx = heroCodeCanvas.getContext("2d");
    const sampleCanvas = document.createElement("canvas");
    const sampleCtx = sampleCanvas.getContext("2d", { willReadFrequently: true });
    const revealPoints = [];
    const codeSource = [
      "grade=node(balance_lift,gamma,gain) ",
      "cst=input(logc3):output(bt709) ",
      "python:def match_shot(frame):return preserve_texture(frame) ",
      "vec3 colour=texture(scene,uv).rgb; ",
      "halation=strength*softclip(highlights); ",
      "resolve.timeline.render(deliver='prores'); ",
      "gl_FragColor=vec4(contrast(sat(colour)),1.0); ",
      "curve=filmic(shoulder,toe,microcontrast); ",
      "matrix=bt709 transfer=bt709 primaries=bt709 ",
      "grain=temporal_subtle(edge_safe=True) "
    ].join("");

    let fontSize = 15;
    let charWidth = 9;
    let lineHeight = 18;
    let columns = 0;
    let rows = 0;
    let scrollRow = 0;
    let lastScrollAt = performance.now();
    let resizeFrame = 0;

    const measureGrid = () => {
      if (!ctx) return;
      const rect = homeHero.getBoundingClientRect();
      heroCodeCanvas.width = Math.max(1, Math.floor(rect.width * dpr));
      heroCodeCanvas.height = Math.max(1, Math.floor(rect.height * dpr));
      heroCodeCanvas.style.width = `${rect.width}px`;
      heroCodeCanvas.style.height = `${rect.height}px`;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      fontSize = Math.max(11, Math.min(16, rect.width / 108));
      lineHeight = Math.round(fontSize * 1.28);
      ctx.font = `500 ${fontSize}px "IBM Plex Mono", "SFMono-Regular", "SF Mono", "Menlo", monospace`;
      charWidth = Math.max(7, Math.ceil(ctx.measureText("0").width));
      columns = Math.ceil(rect.width / charWidth) + 2;
      rows = Math.ceil(rect.height / lineHeight) + 2;
      sampleCanvas.width = columns;
      sampleCanvas.height = rows;
    };

    const addRevealPoint = (x, y, radius) => {
      revealPoints.push({ x, y, radius, life: 1 });
      if (revealPoints.length > 120) revealPoints.shift();
    };

    const pointerMove = (event) => {
      const rect = homeHero.getBoundingClientRect();
      addRevealPoint(event.clientX - rect.left, event.clientY - rect.top, 110);
      homeHero.classList.add("is-interactive");
    };

    const pointerLeave = () => {
      addRevealPoint(-9999, -9999, 0);
      homeHero.classList.remove("is-interactive");
    };

    const revealStrengthAt = (x, y) => {
      let strength = 0;
      for (let i = 0; i < revealPoints.length; i += 1) {
        const point = revealPoints[i];
        if (point.radius <= 0 || point.life <= 0) continue;
        const dx = x - point.x;
        const dy = y - point.y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        if (distance > point.radius) continue;
        const local = (1 - distance / point.radius) * point.life;
        if (local > strength) strength = local;
      }
      return strength;
    };

    const drawFrame = (now) => {
      requestAnimationFrame(drawFrame);
      if (!ctx || !sampleCtx) return;
      if (heroVideo.readyState < 2 || columns === 0 || rows === 0) return;

      if (now - lastScrollAt > 1000) {
        scrollRow = (scrollRow + 1) % 10000;
        lastScrollAt = now;
      }

      sampleCtx.clearRect(0, 0, sampleCanvas.width, sampleCanvas.height);
      sampleCtx.drawImage(heroVideo, 0, 0, sampleCanvas.width, sampleCanvas.height);
      const sampleData = sampleCtx.getImageData(0, 0, sampleCanvas.width, sampleCanvas.height).data;

      ctx.clearRect(0, 0, heroCodeCanvas.width, heroCodeCanvas.height);
      ctx.font = `500 ${fontSize}px "IBM Plex Mono", "SFMono-Regular", "SF Mono", "Menlo", monospace`;
      ctx.textBaseline = "top";

      for (let i = revealPoints.length - 1; i >= 0; i -= 1) {
        revealPoints[i].life -= 0.00135;
        revealPoints[i].radius += 0.035;
        if (revealPoints[i].life <= 0) {
          revealPoints.splice(i, 1);
        }
      }

      for (let row = 0; row < rows; row += 1) {
        const y = row * lineHeight;
        const sourceRowOffset = ((row + scrollRow) * 37) % codeSource.length;

        for (let col = 0; col < columns; col += 1) {
          const x = col * charWidth;
          const reveal = revealStrengthAt(x + charWidth * 0.5, y + lineHeight * 0.5);
          if (reveal < 0.015) continue;

          const sourceIndex = (sourceRowOffset + col) % codeSource.length;
          const char = codeSource[sourceIndex];
          const sampleIndex = ((row * sampleCanvas.width) + Math.min(col, sampleCanvas.width - 1)) * 4;
          const r = sampleData[sampleIndex] || 240;
          const g = sampleData[sampleIndex + 1] || 230;
          const b = sampleData[sampleIndex + 2] || 220;
          const luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
          const alpha = Math.min(0.88, reveal * (0.55 + luminance * 0.8));

          ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
          ctx.fillText(char, x, y);
        }
      }
    };

    const resize = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(measureGrid);
    };

    measureGrid();
    requestAnimationFrame(drawFrame);

    homeHero.addEventListener("pointermove", pointerMove);
    homeHero.addEventListener("pointerleave", pointerLeave);
    homeHero.addEventListener("pointerenter", () => homeHero.classList.add("is-interactive"));
    window.addEventListener("resize", resize);
  }
</script>
