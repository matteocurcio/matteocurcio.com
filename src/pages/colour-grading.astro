---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServicesEnquiry from "../components/ServicesEnquiry.astro";
import { SITE_CONFIG } from "../config/site";

const siteUrl = `https://${SITE_CONFIG.primaryDomain}`;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteUrl}/colour-grading/#service`,
  name: "Colour Grading",
  serviceType: "Colour grading, look development and colour-managed finishing",
  url: `${siteUrl}/colour-grading/`,
  provider: {
    "@id": `${siteUrl}/#person`
  },
  areaServed: [
    {
      "@type": "City",
      name: "Melbourne"
    },
    {
      "@type": "Country",
      name: "Australia"
    },
    "Remote"
  ],
  audience: {
    "@type": "Audience",
    audienceType: "Production companies, agencies, directors and post-production teams"
  }
};

const projects = [
  {
    title: "Make Waves",
    client: "Yamaha",
    href: "/projects/yamaha/",
    image: "/assets/projects/yamaha-make-waves/thumbnail_yamaha.webp",
    alt: "Colour graded Yamaha Make Waves commercial frame"
  },
  {
    title: "National Hero",
    client: "Football Australia",
    href: "/projects/national-hero/",
    image: "/assets/projects/football-australia-national-hero/thumbnail_national_hero.webp",
    alt: "Colour graded Football Australia National Hero campaign frame"
  },
  {
    title: "Quay Quarter",
    client: "AMP",
    href: "/projects/amp/",
    image: "/assets/projects/amp-quay-quarter/thumbnail_amp.webp",
    alt: "Colour graded AMP Quay Quarter commercial frame"
  }
];

const carouselProjects = [
  ...projects.map((project) => ({ project, isClone: false })),
  ...projects.map((project) => ({ project, isClone: true }))
];

const process = [
  {
    title: "Look development",
    body: "Finding the visual character of a campaign before the job becomes a shot-by-shot correction exercise. Usually built from references, a test grade on selected frames, and a look that holds up across the whole cut rather than one hero shot."
  },
  {
    title: "Colour management",
    body: "Building a reliable path through camera sources, review exports and final masters in DaVinci Resolve. Mixed cameras, log formats and delivery colour spaces resolved once at the start, so the grade behaves the same in the suite, in review and on the final screen."
  },
  {
    title: "Matching and continuity",
    body: "Balancing exposure, colour matching, skin tones, product colour and mixed lighting so the work cuts cleanly. Skin and brand colour are the two that get noticed when they drift, and they are usually the reason a cut feels uneven before anyone can say why."
  },
  {
    title: "Delivery-aware grading",
    body: "Keeping the grade practical for commercials, branded content, agency review, versioning and final delivery. A look that falls apart in a 1:1 crop or a broadcast-legal pass is a problem you would rather find before the master, not after."
  }
];
---

<BaseLayout
  title="Colour Grading Melbourne | Matteo Curcio"
  description="Melbourne colourist providing colour grading, look development and colour-managed finishing for commercials, branded content and agency productions. Available in Melbourne and remotely."
  path="/colour-grading/"
  navSection="services"
  ogImage="/assets/projects/yamaha-make-waves/thumbnail_yamaha.webp"
  ogImageAlt="Colour graded Yamaha commercial frame"
  structuredData={serviceSchema}
>
  <section class="page-head">
    <p class="kicker">Colour Grading</p>
    <h1>Colour grading for commercial and branded work.</h1>
    <p>
      I provide colour grading and look development for commercials, branded content, campaigns and selected narrative
      work from Melbourne, working directly with production companies, agencies, directors and post-production teams.
    </p>
    <p>
      The work ranges from shot matching and technical colour management through to developing the final visual character
      of a piece. The objective is not simply consistency. It is deciding where the eye should go, how skin should
      reproduce, how product and brand colours should behave, and how the image should feel when it reaches its final
      screen.
    </p>
    <p>
      Projects can move through DaVinci Resolve as standalone grading sessions or as part of a complete
      <a href="/finishing/">online and finishing workflow</a>, including conform, cleanup, versioning, QC and final
      delivery. I work with clients in Melbourne and remotely, running calibrated remote review sessions where a
      supervised grade in person is not practical.
    </p>
  </section>

  <section class="section lane-grid" aria-label="Colour grading services">
    {process.map((item) => (
      <article class="lane">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </section>

  <section class="section" aria-label="Selected colour grading projects">
    <div class="page-head">
      <p class="kicker">Selected Work</p>
      <h2>Commercial grades with real delivery constraints.</h2>
      <p>
        Relevant portfolio examples across commercial, sport, property and branded work.
      </p>
    </div>
    <div class="home-carousel" data-colour-work-carousel>
      <div class="home-carousel-track" data-colour-work-carousel-track>
        {carouselProjects.map(({ project, isClone }) => (
          <article class="post-card coding-card home-carousel-slide" aria-hidden={isClone ? "true" : undefined}>
            <a href={project.href} tabindex={isClone ? -1 : undefined}>
            <div class="thumb-frame">
              <img class="thumb" src={project.image} alt={project.alt} loading="lazy" />
            </div>
            <div class="body">
              <p class="post-meta">{project.client}</p>
              <h3>{project.title}</h3>
              <p>View the {project.title} project.</p>
            </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ServicesEnquiry heading="Need a Melbourne colourist?" subject="Colour grading enquiry" />

  <nav class="about-pathways section security-pathways" aria-label="Related pages">
    <a class="about-pathway" href="/finishing/">
      <span class="about-pathway-label">Online editing &amp; finishing</span>
      <span class="about-pathway-note">Conform, cleanup, versioning, QC and delivery.</span>
    </a>
    <a class="about-pathway" href="/works/">
      <span class="about-pathway-label">Portfolio</span>
      <span class="about-pathway-note">Selected commercial and branded post-production work.</span>
    </a>
    <a class="about-pathway" href="/tutoring/">
      <span class="about-pathway-label">Tutoring</span>
      <span class="about-pathway-note">One-on-one and group sessions for editors who want to improve their colour work.</span>
    </a>
  </nav>

  <script is:inline>
    (() => {
      const carousel = document.querySelector("[data-colour-work-carousel]");
      const track = document.querySelector("[data-colour-work-carousel-track]");
      if (!carousel || !track) return;

      const slides = Array.from(track.querySelectorAll(".home-carousel-slide"));
      if (slides.length < 2) return;

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const step = () => {
        const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
        return slides[0].getBoundingClientRect().width + gap;
      };

      const half = () => (slides.length / 2) * step();
      const wrap = () => {
        if (track.scrollLeft >= half()) track.scrollLeft -= half();
        else if (track.scrollLeft <= 0) track.scrollLeft += half();
      };

      let settle = 0;
      track.addEventListener("scroll", () => {
        window.clearTimeout(settle);
        settle = window.setTimeout(wrap, 180);
      });

      if (reduceMotion) return;

      const advance = () => {
        wrap();
        track.scrollBy({ left: step(), behavior: "smooth" });
      };
      let timer = window.setInterval(advance, 4200);
      const pause = () => window.clearInterval(timer);
      const resume = () => {
        pause();
        timer = window.setInterval(advance, 4200);
      };

      carousel.addEventListener("pointerenter", pause);
      carousel.addEventListener("pointerleave", resume);
      carousel.addEventListener("focusin", pause);
      carousel.addEventListener("focusout", resume);
      document.addEventListener("visibilitychange", () => (document.hidden ? pause() : resume()));
    })();
  </script>
</BaseLayout>
