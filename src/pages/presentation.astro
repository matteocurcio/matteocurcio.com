---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientMarquee from "../components/ClientMarquee.astro";
import ThumbnailCarousel from "../components/ThumbnailCarousel.astro";
import { serviceSchema } from "../lib/schema";
import { CONTACT_MAILTO } from "../config/site";

const reels = [
  {
    slug: "presentology",
    title: "Presentation Design",
    image: "/assets/reels/reels-presentology/thumbnail_presentology.webp",
    body: "Keynote systems and executive decks built from narrative structure outward, then designed to survive other hands."
  },
  {
    slug: "dataviz",
    title: "Data Visualization",
    image: "/assets/reels/reels-dataviz/thumbnail_dataviz.webp",
    body: "Chart logic, labelling hierarchy, and colour systems that stay legible when the data changes."
  }
];

const slides = [
  { src: "/assets/projects/dubai-tourism-business-events-presentation/slide_01.webp", href: "/projects/dubai-business-events/", deck: "Business Events Presentation", alt: "Opening slide: a diversified economy with events at its heart" },
  { src: "/assets/projects/dubai-tourism-master-business-presentation/slide_02.webp", href: "/projects/dubai-master-business-presentation/", deck: "Master Business Presentation", alt: "Dubai International Airport passenger figures" },
  { src: "/assets/projects/dubai-tourism-business-events-presentation/slide_02.webp", href: "/projects/dubai-business-events/", deck: "Business Events Presentation", alt: "Emirates airline figures laid over a hero image" },
  { src: "/assets/projects/dubai-tourism-master-business-presentation/slide_04.webp", href: "/projects/dubai-master-business-presentation/", deck: "Master Business Presentation", alt: "Dubai Metro passenger figures" },
  { src: "/assets/projects/dubai-tourism-business-events-presentation/slide_13.webp", href: "/projects/dubai-business-events/", deck: "Business Events Presentation", alt: "Bar chart of international visitors to Dubai, 2011 to 2019" },
  { src: "/assets/projects/dubai-tourism-master-business-presentation/slide_08.webp", href: "/projects/dubai-master-business-presentation/", deck: "Master Business Presentation", alt: "Free zones title slide" },
  { src: "/assets/projects/dubai-tourism-business-events-presentation/slide_09.webp", href: "/projects/dubai-business-events/", deck: "Business Events Presentation", alt: "Trade and economy statistics over an aerial port view" },
  { src: "/assets/projects/dubai-tourism-master-business-presentation/slide_12.webp", href: "/projects/dubai-master-business-presentation/", deck: "Master Business Presentation", alt: "Re-exports figures over a container ship" },
  { src: "/assets/projects/dubai-tourism-business-events-presentation/slide_06.webp", href: "/projects/dubai-business-events/", deck: "Business Events Presentation", alt: "Global rankings laid over a perspective road" },
  { src: "/assets/projects/dubai-tourism-master-business-presentation/slide_07.webp", href: "/projects/dubai-master-business-presentation/", deck: "Master Business Presentation", alt: "Section opener: the knowledge ecosystem" },
  { src: "/assets/projects/dubai-tourism-business-events-presentation/slide_12.webp", href: "/projects/dubai-business-events/", deck: "Business Events Presentation", alt: "Full-bleed quote slide" },
  { src: "/assets/projects/dubai-tourism-master-business-presentation/slide_09.webp", href: "/projects/dubai-master-business-presentation/", deck: "Master Business Presentation", alt: "Pro-business ecosystem tax figures" }
];

const principles = [
  {
    title: "Structure Before Surface",
    body: "I build presentation systems from narrative structure outward: what's the argument, what's the hierarchy, where does the audience need to breathe. The visual framework comes after that, designed around the case being made rather than decorating it afterwards."
  },
  {
    title: "A Deck Only You Can Update Is A Liability",
    body: "Most decks fall apart the moment someone other than the designer touches them. A layout that only works in the original presenter's hands isn't a template. Clean master slides, locked type systems, and logical naming mean anyone on the team can swap a chart or restructure a section without the whole thing collapsing."
  },
  {
    title: "Legible In Thirty Seconds",
    body: "A chart that needs a paragraph of explanation underneath it has failed at its job. Data visualisation isn't about making numbers look interesting, it's about making them legible to someone who has thirty seconds and a decision to make."
  },
  {
    title: "Designed To Survive Revisions",
    body: "Revision cycles are where most dashboards and reports start drifting: a quick fix here, a cramped label there, and suddenly nothing reads cleanly. Because the data always changes, I build these to survive updates rather than just the first round of approval."
  }
];

const pathways = [
  {
    href: "/services/",
    label: "Services",
    note: "The full commercial picture: finishing, immersive, presentation, coaching, and consulting."
  },
  {
    href: "/works/",
    label: "Projects",
    note: "Presentation and data-led projects alongside the rest of the commercial work."
  },
  {
    href: "/workflow/",
    label: "Workflow & infrastructure",
    note: "The template systems and process design that keep a deck maintainable after handoff."
  },
  {
    href: "/reels/",
    label: "Reels",
    note: "Every reel in one place, including presentation and data visualisation."
  }
];

const pageSchema = serviceSchema({
  path: "/presentation/",
  name: "Presentation Design and Data Visualisation",
  serviceType: "Executive presentations, keynote visuals and data visualisation",
  audience: "Organisations, government bodies and senior leadership teams"
});

---

<BaseLayout
  title="Presentation Design & Data Visualisation | Matteo Curcio"
  description="Strategic presentations, keynote visuals and data visualisation for executive audiences, pitches, events and broadcast."
  path="/presentation"
  structuredData={pageSchema}
>
  <section class="page-head">
    <p class="kicker">Presentation &amp; Data-Viz</p>
    <h1>Made to hold a room, and to survive the next revision.</h1>
    <p>
      Strategic presentations and visual communication for executive audiences, pitches, events, and broadcast contexts.
      Designed to hold attention quickly and carry authority in the room — then designed again so the team can keep using
      it after I hand it over.
    </p>
    <p>
      For organisations, government bodies, and senior teams who need to communicate clearly at scale.
    </p>
  </section>

  <section class="section lane-grid" aria-label="How presentation work is approached">
    <h2 class="sr-only">How presentation work is approached</h2>
    {principles.map((item) => (
      <article class="lane">
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </section>

  <section class="section presentation-slides" aria-label="Selected slides">
    <h2>Selected slides</h2>
    <p class="presentation-slides-note">From two decks for Dubai Tourism, designed as Senior Designer at Touchline Dubai.</p>
    <div class="presentation-slide-grid">
      {slides.map((slide) => (
        <a class="presentation-slide" href={slide.href}>
          <img src={slide.src} alt={slide.alt} width="1600" height="900" loading="lazy" decoding="async" />
          <span>Dubai Tourism · {slide.deck}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-label="Presentation reels">
    <h2 class="sr-only">Presentation reels</h2>
    <ThumbnailCarousel
      items={reels.map((reel) => ({
        title: reel.title,
        href: `/reels/${reel.slug}/`,
        image: reel.image,
        imageAlt: `${reel.title} reel thumbnail`,
        meta: "Reel",
        body: reel.body
      }))}
      ariaLabel="Presentation reels"
    />
    <ClientMarquee />
  </section>

  <section class="cta section">
    <div>
      <h2>Something important to present?</h2>
      <p>
        A pitch, a keynote, a board deck, or a reporting system that has stopped reading clearly. Tell me the audience and
        the argument and we can work backwards from there.
      </p>
    </div>
    <a href={CONTACT_MAILTO}>Get in touch</a>
  </section>

  <nav class="about-pathways section security-pathways" aria-label="Presentation page links">
    {pathways.map((item) => (
      <a class="about-pathway" href={item.href}>
        <span class="about-pathway-label">{item.label}</span>
        <span class="about-pathway-note">{item.note}</span>
      </a>
    ))}
  </nav>
</BaseLayout>
