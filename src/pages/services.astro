---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    number: "01",
    icon: "/icons/services/post.svg",
    iconAlt: "Post-production",
    name: "Colour, Online Editing & Finishing",
    tag: "Commercial colour grading, online edit, polish, delivery",
    description:
      "Colour grading, online editing, editorial polish, motion cleanup, versioning, and final delivery for commercial and branded work. I can step in mid-stream, tighten the finish, and get masters out cleanly.",
    audience: "Producers, directors, and agencies who need finishing they can rely on.",
    ctaLabel: "Finishing Services",
    ctaUrl: "/finishing",
    subLinks: [
      { label: "Colour grading", href: "/color" },
      { label: "Online editing", href: "/editing" }
    ]
  },
  {
    number: "02",
    icon: "/icons/services/immersive.svg",
    iconAlt: "Immersive",
    name: "Immersive & Interactive",
    tag: "Mapping, immersive installs, AR, environment-led media",
    description:
      "Projection mapping, immersive video, augmented reality, and in-store media built for real spaces. I understand both the creative ambition and the operational complexity of getting it live properly.",
    audience: "Brands, agencies, and event producers with an environment to fill.",
    ctaLabel: "Immersive Work",
    ctaUrl: "/immersive"
  },
  {
    number: "03",
    icon: "/icons/services/strategy.svg",
    iconAlt: "Presentation and strategy",
    name: "Presentation & Data-Viz",
    tag: "Executive decks, keynote visuals, data communication",
    description:
      "Strategic presentations and visual communication for executive audiences, pitches, events, and broadcast contexts. Designed to hold attention quickly and carry authority in the room.",
    audience:
      "Organisations, government bodies, and senior teams who need to communicate clearly at scale.",
    ctaLabel: "Presentation Design",
    ctaUrl: "/presentation",
    subLinks: [{ label: "Motion design", href: "/motion" }]
  },
  {
    number: "04",
    icon: "/icons/services/workflow.svg",
    iconAlt: "Workflow and infrastructure",
    name: "Workflow, Infrastructure & Security Consulting",
    tag: "Audit, storage, permissions, handoffs, backups",
    description:
      "For studios and production teams hitting the same failures over and over: broken handoffs, version confusion, brittle storage, unclear permissions, and weak backups. I audit what is fragile and make it more reliable.",
    audience:
      "Operations managers, heads of production, studio owners, and teams who know something is fragile even if they have not named it properly yet.",
    ctaLabel: "Workflow Design",
    ctaUrl: "/workflow"
  },
  {
    number: "05",
    icon: "/icons/services/teaching.svg",
    iconAlt: "Coaching and training",
    name: "Coaching & Training",
    tag: "Resolve, Adobe, AI-assisted workflows",
    description:
      "Private sessions on Resolve, Adobe, and AI-assisted creative workflows for working professionals. Practical help for closing a real gap, not a generic course.",
    audience:
      "Editors, photographers, DOPs, designers, and producers who want to move faster without cutting corners.",
    ctaLabel: "Coaching & Training",
    ctaUrl: "/tutoring"
  },
  {
    number: "06",
    icon: "/icons/services/music.svg",
    iconAlt: "Music",
    name: "Music & Score",
    tag: "Original composition, sync, score, royalty-free cues",
    description:
      "Original music, sync placement, and score for film, television, and advertising, written as one half of Grammy-nominated Musetta. Cinematic writing built around space, texture, and restraint, delivered production-ready.",
    audience:
      "Directors, producers, and agencies who need music that sits inside the picture rather than on top of it.",
    ctaLabel: "Music",
    ctaUrl: "/music"
  }
];
---

<BaseLayout
  title="Services | Colour Grading, Online Editing & Finishing in Melbourne"
  description="Colour grading, online editing, finishing, motion, delivery, and workflow consulting for commercial and branded post-production. Melbourne-based, remote-friendly."
  path="/services"
  ogImage="/images/og/matteo-curcio-services-og.png"
  ogImageAlt="Matteo Curcio services social card for finishing, workflow, training, and systems support"
>
  <section class="services-head">
    <h1>OK, but what do you do exactly?</h1>
    <p>
      Colour grading, online editing, post-production finishing, motion, delivery, and workflow consulting for commercial and branded work.
      Clear scope, practical execution, and reliable delivery when the job needs to land properly.
    </p>
  </section>

  <section class="services-index services-card-grid" aria-label="Service areas">
    {services.map((service) => (
      <article class="service-card">
        <div class="service-card-head">
          <span class="service-number services-grid-icon" aria-hidden="true">
            <img class="service-app-icon" src={service.icon} alt={service.iconAlt} loading="lazy" />
          </span>
          <div class="service-card-title-group">
            <h2 class="service-name">{service.name}</h2>
            <p class="service-tag">{service.tag}</p>
          </div>
        </div>

        <div class="service-card-body">
          <p class="service-description">{service.description}</p>
          <p class="service-audience"><em>For {service.audience}</em></p>
          <div class="service-cta-wrap">
            <a class="button-link services-card-button" href={service.ctaUrl}>
              {service.ctaLabel}
            </a>
            {service.subLinks?.map((link) => (
              <a class="button-link services-card-button" href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="services-enquiry" aria-label="Services enquiry form">
    <div class="services-enquiry-grid">
      <form class="services-form" data-services-form novalidate>
        <p class="services-form-intro">
          I am available in person across Melbourne or remotely, depending on project needs, timeline, and workflow.
        </p>
        <div class="services-form-grid">
          <label>
            Name
            <input type="text" name="name" autocomplete="name" maxlength="80" required />
          </label>
          <label>
            Email
            <input type="email" name="email" autocomplete="email" maxlength="120" required />
          </label>
        </div>
        <label>
          Message
          <textarea
            name="message"
            rows="6"
            maxlength="2200"
            placeholder="Share what you need."
            required
          ></textarea>
        </label>
        <label class="hp-field" aria-hidden="true">
          Website
          <input type="text" name="website" autocomplete="off" tabindex="-1" />
        </label>
        <input type="hidden" name="formStartedAt" data-form-started-at />
        <div class="services-form-actions">
          <button type="submit" class="services-submit">Send enquiry</button>
          <p class="services-form-note" data-form-note aria-live="polite"></p>
        </div>
      </form>

      <aside class="services-enquiry-panel" aria-label="How projects usually begin">
        <div class="services-enquiry-panel-block">
          <p class="services-enquiry-eyebrow">How projects usually start</p>
          <h2>You do not need the whole brief solved yet.</h2>
          <p>
            A clear first email is enough. Scope, timeline, where the friction is, and what has to land well.
            We can shape the rest from there.
          </p>
        </div>

        <div class="services-enquiry-panel-block services-enquiry-panel-split">
          <div>
            <p class="services-enquiry-minihead">Typical entry points</p>
            <p class="services-enquiry-list">
              A project needs finishing fast without losing taste. An installation or presentation has to become
              technically reliable. A workflow is working, but only just.
            </p>
          </div>
          <div>
            <p class="services-enquiry-minihead">Working modes</p>
            <p class="services-enquiry-list">
              Melbourne-based in person when the room matters. Remote for reviews, consulting, and delivery
              support. Short interventions or longer project involvement.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
  
</BaseLayout>

<script is:inline>

  const form = document.querySelector("[data-services-form]");
  const formNote = document.querySelector("[data-form-note]");
  const startedAtInput = document.querySelector("[data-form-started-at]");
  const THROTTLE_MS = 60000;
  const MIN_FILL_MS = 4000;
  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const LAST_SUBMIT_KEY = "mc_services_last_submit";
  const FORM_ENDPOINT = "https://formsubmit.co/ajax/hello@matteocurcio.com";

  if (startedAtInput instanceof HTMLInputElement) {
    startedAtInput.value = String(Date.now());
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const now = Date.now();
      const lastSubmit = Number(window.localStorage.getItem(LAST_SUBMIT_KEY) || "0");
      if (lastSubmit && now - lastSubmit < THROTTLE_MS) {
        if (formNote) {
          formNote.textContent = "Please wait a minute before sending another enquiry.";
        }
        return;
      }

      const formData = new FormData(form);
      const website = String(formData.get("website") || "").trim();
      if (website.length > 0) {
        if (formNote) {
          formNote.textContent = "Unable to send this enquiry.";
        }
        return;
      }

      const startedAt = Number(formData.get("formStartedAt") || "0");
      if (!startedAt || now - startedAt < MIN_FILL_MS) {
        if (formNote) {
          formNote.textContent = "Please take a few seconds to complete the form.";
        }
        return;
      }

      const name = String(formData.get("name") || "").trim();
      const email = String(formData.get("email") || "").trim();
      const message = String(formData.get("message") || "").trim();

      if (!name || !EMAIL_REGEX.test(email) || message.length === 0 || message.length > 2200) {
        if (formNote) {
          formNote.textContent = "Please complete all fields correctly before sending.";
        }
        return;
      }

      if (formNote) {
        formNote.textContent = "Sending enquiry...";
      }

      const submitButton = form.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        const response = await fetch(FORM_ENDPOINT, {
          method: "POST",
          headers: {
            Accept: "application/json"
          },
          body: new URLSearchParams({
            name,
            email,
            message,
            _subject: "Services enquiry",
            _template: "table",
            _honey: website
          })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok || (payload && payload.success === "false")) {
          throw new Error("Form submission failed.");
        }

        window.localStorage.setItem(LAST_SUBMIT_KEY, String(now));
        form.reset();
        if (startedAtInput instanceof HTMLInputElement) {
          startedAtInput.value = String(Date.now());
        }
        if (formNote) {
          formNote.textContent = "Enquiry sent. Thank you.";
        }
      } catch (error) {
        if (formNote) {
          formNote.textContent = "Unable to send right now. Please try again shortly.";
        }
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  }
</script>
