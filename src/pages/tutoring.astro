---
import BaseLayout from "../layouts/BaseLayout.astro";

const tutoringAreas = [
  {
    number: "01",
    icon: "/icons/apps/resolve-studio.png",
    iconAlt: "DaVinci Resolve",
    name: "DaVinci Resolve",
    tag: "Edit, grade, deliver fast",
    description:
      "Resolve is powerful because it joins edit, grade, audio, VFX, and delivery in one place. Sessions focus on the part you actually need, using your footage, your timeline, and the gaps slowing you down.",
    audience:
      "Editors, colorists, DOPs, directors, and content creators who want to work in Resolve properly - not just survive in it.",
    ctaLabel: "Book a Resolve session",
    ctaUrl: "https://www.superprof.com.au/certified-davinci-resolve-editor-and-colorist-offering-one-one-training-for-editors-videomakers-influencers-directors-dop-and.html"
  },
  {
    number: "02",
    icon: "/icons/apps/premiere-pro.png",
    iconAlt: "Adobe Premiere Pro",
    name: "Adobe Premiere Pro",
    tag: "Timeline flow and exports",
    description:
      "Premiere sessions are about speed, organisation, and fewer avoidable mistakes. We work on sequence structure, multicam, Dynamic Link, exports, and the habits that keep projects moving cleanly.",
    audience:
      "Editors at any level who want to work faster, waste less time troubleshooting, and stop rediscovering the same things repeatedly.",
    ctaLabel: "Book a Premiere session",
    ctaUrl: "https://www.superprof.com.au/certified-davinci-resolve-editor-and-colorist-offering-one-one-training-for-editors-videomakers-influencers-directors-dop-and.html"
  },
  {
    number: "03",
    icon: "/icons/apps/after-effects.png",
    iconAlt: "Adobe After Effects",
    name: "After Effects",
    tag: "Animation and compositing basics",
    description:
      "After Effects gets easier once the structure makes sense. Sessions cover motion basics, compositing, pre-comps, expressions, and the points where After Effects and Premiere usually start wasting your time.",
    audience:
      "Editors moving into motion, motion designers filling technical gaps, and anyone who has been faking their way through expressions.",
    ctaLabel: "Book an After Effects session",
    ctaUrl: "https://www.superprof.com.au/certified-davinci-resolve-editor-and-colorist-offering-one-one-training-for-editors-videomakers-influencers-directors-dop-and.html"
  },
  {
    number: "04",
    icon: "/icons/apps/photoshop.png",
    iconAlt: "Adobe Photoshop",
    name: "Adobe Photoshop",
    tag: "Retouching, masking, finishing",
    description:
      "Photoshop sessions focus on the detailed end of the image: retouching, masking, cleanup, compositing, and the small technical decisions that make stills feel properly finished.",
    audience:
      "Photographers, retouchers, designers, and content creators who want more control over the final image instead of relying on guesswork.",
    ctaLabel: "Book a Photoshop session",
    ctaUrl: "https://www.superprof.com.au/certified-davinci-resolve-editor-and-colorist-offering-one-one-training-for-editors-videomakers-influencers-directors-dop-and.html"
  },
  {
    number: "05",
    icon: "/icons/apps/lightroom.png",
    iconAlt: "Adobe Lightroom",
    name: "Adobe Lightroom",
    tag: "Catalogues, grading, batch flow",
    description:
      "Lightroom sessions are about speed and consistency across whole bodies of work. We can focus on catalogue structure, colour workflow, batch editing, exports, and keeping large libraries manageable.",
    audience:
      "Photographers and image-makers who want a cleaner, faster workflow from ingest to export.",
    ctaLabel: "Book a Lightroom session",
    ctaUrl: "https://www.superprof.com.au/certified-davinci-resolve-editor-and-colorist-offering-one-one-training-for-editors-videomakers-influencers-directors-dop-and.html"
  },
  {
    number: "06",
    icon: "/icons/apps/adobe-suite.png",
    iconAlt: "Adobe Creative Cloud",
    name: "Adobe Suite as a System",
    tag: "Connected suite-wide production",
    description:
      "This is for people using Adobe all day but feeling the workflow is messier than it should be. We look at file structure, asset flow, shared libraries, and which tool should handle which part of the job.",
    audience:
      "Designers, creative directors, and production teams who live inside Adobe all day and suspect there is a smarter way to organise it all.",
    ctaLabel: "Book a workflow session",
    ctaUrl: "https://www.superprof.com.au/certified-davinci-resolve-editor-and-colorist-offering-one-one-training-for-editors-videomakers-influencers-directors-dop-and.html"
  },
  {
    number: "07",
    icon: "/icons/apps/adobe-express-official.png",
    iconAlt: "Adobe Express",
    name: "Adobe Express",
    tag: "Fast branded content systems",
    description:
      "Adobe Express is best when speed and consistency matter at the same time. Sessions cover brand kits, templates, simple motion, and repeatable content systems that do not need a full design team behind them.",
    audience:
      "Marketing teams, content creators, educators, and small business owners who need to produce consistent, professional-looking content quickly and without a steep learning curve.",
    ctaLabel: "Book an Express session",
    ctaUrl: "https://www.superprof.com.au/certified-davinci-resolve-editor-and-colorist-offering-one-one-training-for-editors-videomakers-influencers-directors-dop-and.html"
  },
  {
    number: "08",
    icon: "/icons/apps/ai-workflows.svg",
    iconAlt: "AI-assisted workflows",
    name: "AI-Assisted Workflows",
    tag: "Automation, prompting, practical creative systems",
    description:
      "This is for people who want to use AI tools sensibly inside real creative work: research support, transcript cleanup, first-pass asset organisation, prompt design, and small automations that save time without making the work generic.",
    audience:
      "Editors, photographers, designers, educators, and small teams who want practical AI habits they can trust rather than hype they cannot repeat.",
    ctaLabel: "Book an AI workflow session",
    ctaUrl: "https://www.superprof.com.au/certified-davinci-resolve-editor-and-colorist-offering-one-one-training-for-editors-videomakers-influencers-directors-dop-and.html"
  }
