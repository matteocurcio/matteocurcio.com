---
import { CONTACT_MAILTO, SITE_CONFIG } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientMarquee from "../components/ClientMarquee.astro";
import ThumbnailCarousel from "../components/ThumbnailCarousel.astro";
import { serviceSchema } from "../lib/schema";

const capabilities = [
  {
    title: "Colour grading",
    body:
      "Look development, then the slow part: matching across mixed cameras and mixed light. The tell is skin warm on one angle, green on the reverse, and nobody able to say why the cut feels uneven. Colour management settled before the first node."
  },
  {
    title: "Online editing and conform",
    body:
      "Rebuilding the offline against camera originals and finding what the EDL quietly lost — a speed ramp that resolves differently, a nested effect that did not travel, handles that were never there. Versions built from one source, not fifteen times by hand."
  },
  {
    title: "Finishing and delivery",
    body:
      "Masters cut to the spec the broadcaster published, not the one someone remembered. Correct codec, colour metadata, loudness, naming. Most QC rejections are not creative disagreements. They are a flag set wrong in an export preset three weeks earlier."
  },
  {
    title: "Workflow support",
    body:
      "The unglamorous half. Relinks that fail, timelines too fragile to reopen, naming that made sense to one person in one week. Worth paying for when the process itself has become the risk."
  }
];

const faqs = [
  {
    question: "How do you charge?",
    answer:
      "Day rate, or a fixed quote where the scope is clear enough to price as a package. Versioning and delivery quote flat more easily than the grade."
  },
  {
    question: "Can we attend the grade?",
    answer:
      "I work remotely rather than hosting attended sessions. Review goes out as files and notes come back over email or a call. It keeps room and attendance costs out of the quote — on a commercial, not a small share of it."
  },
  {
    question: "What do I send you?",
    answer:
      "A locked cut, the project file, camera originals, your delivery specs, and anything the client has already signed off. If the specs are the part you are unsure about, send what you have and I will tell you what is missing."
  },
  {
    question: "What do you work in?",
    answer:
      "DaVinci Resolve for grade and finish. Conform comes in from Premiere, Final Cut Pro or Resolve — an XML with handles is enough to start."
  }
];

const heroProjects = [
  {
    title: "A Gentle Giant",
    client: "Gigabyte",
    href: "/projects/a-gentle-giant/",
    image: "/assets/projects/gigabyte-a-gentle-giant/thumbnail_a_gentle_giant.webp"
  },
  {
    title: "Quay Quarter",
    client: "AMP",
    href: "/projects/amp/",
    image: "/assets/projects/amp-quay-quarter/thumbnail_amp.webp"
  },
  {
    title: "National Hero",
    client: "Football Australia",
    href: "/projects/national-hero/",
    image: "/assets/projects/football-australia-national-hero/thumbnail_national_hero.webp"
  }
];

const pageSchema = serviceSchema({
  path: "/finishing/",
  name: "Post-Production Finishing",
  alternateName: [
    "Colour grading and finishing",
    "Color grading and finishing",
    "Post-production finishing"
  ],
  serviceType: "Colour grading, online editing, conform, QC and final delivery",
  audience: "Producers, agencies and studios delivering commercial and branded work"
});

---

<BaseLayout
  title="Post-Production Finishing Melbourne | Colour, Online Editing & Delivery"
  description="Melbourne post-production finishing: colour grading, online editing, conform, versioning, QC and delivery for commercial, branded and agency work."
  path="/finishing"
  structuredData={pageSchema}
  navSection="services"
  ogImage="/images/og/matteo-curcio-services-og.png"
  ogImageAlt="Matteo Curcio colour grading, online editing, and finishing services"
>
  <section class="services-head page-head">
    <p class="kicker">Colour / Online / Finishing</p>
    <h1>Post-production finishing in Melbourne</h1>
    <p class="services-head-standfirst">Colour grading, online editing and delivery, from one pair of hands.</p>
    <p>
      I am Matteo Curcio, a Melbourne-based colourist and online editor. I take commercial and branded jobs from a
      locked cut to approved masters — <a href="/colour-grading/">grade</a>, <a href="/editing/">conform</a>,
      versioning, QC and delivery — remotely, for production companies and agencies here and overseas.
    </p>
  </section>

  <section class="section finishing-hero-work" aria-label="Selected finishing projects">
    <ThumbnailCarousel
      items={heroProjects.map((project) => ({
        title: project.title,
        href: project.href,
        image: project.image,
        imageAlt: `${project.title} project thumbnail`,
        meta: project.client,
        body: `View the ${project.title} project.`
      }))}
      ariaLabel="Selected finishing projects"
    />
    <ClientMarquee />
  </section>

  <section class="finishing-intro section">
    <div class="panel finishing-intro-panel">
      <p>
        Finishing is not a stage at the end of a job. It is where every earlier decision gets tested at once.
      </p>
      <p>
        A look that held on three hero frames and comes apart across the cut. An online that survived four rounds of
        notes and then met a 1:1 crop. A master returned the day before air over a flag nobody set deliberately. None
        of those are creative failures, and they all arrive where the schedule has least room to absorb them.
      </p>
      <p>
        That is the work. Not rescue — specification, early enough that rescue is not needed.
      </p>
    </div>
  </section>

  <section class="services-index services-card-grid finishing-card-grid" aria-label="Colour grading, online editing, and finishing capabilities">
    {capabilities.map((item) => (
      <article class="service-card">
        <div class="service-card-head">
          <div class="service-card-title-group">
            <h2 class="service-name">{item.title}</h2>
          </div>
        </div>
        <div class="service-card-body">
          <p class="service-description">{item.body}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="home-section section">
    <div class="panel finishing-faq">
      <p class="kicker">FAQ</p>
      <h2>Before you send the job.</h2>
      <div class="finishing-faq-grid">
        {faqs.map((item) => (
          <article>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section section">
    <div class="home-cta">
      <div>
        <p class="kicker">Start here</p>
        <h2>Post-house finish, without the post house.</h2>
        <p>
          Tell me what you are making, where it is up to, and what has to be delivered. I will come back with an
          approach and a quote.
          <br />
          Direct email: <a href={CONTACT_MAILTO}>{SITE_CONFIG.contactEmail}</a>
        </p>
      </div>
      <div class="home-cta-actions">
        <a class="home-button home-button-primary" href={CONTACT_MAILTO}>Start a project</a>
        <a class="home-button" href="/works/">View projects</a>
        <a class="home-button" href="/reels/finishing/">View finishing reel</a>
        <a class="home-button" href="/remote/">Remote grading</a>
      </div>
    </div>
  </section>
</BaseLayout>
