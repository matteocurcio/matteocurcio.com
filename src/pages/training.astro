---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServicesEnquiry from "../components/ServicesEnquiry.astro";
import { SITE_CONFIG } from "../config/site";

const tutoringAreas = [
  {
    number: "01",
    icon: "/icons/apps/resolve-studio.png",
    iconAlt: "DaVinci Resolve",
    name: "DaVinci Resolve",
    tag: "Edit, grade, deliver fast",
    description:
      "Resolve is powerful because it joins edit, grade, audio, VFX, and delivery in one place. Sessions focus on the part you actually need, using your footage, your timeline, and the gaps slowing you down.",
    audience:
      "Editors, colorists, DOPs, directors, and content creators who want to work in Resolve properly - not just survive in it.",
    ctaLabel: "Ask about Resolve"
  },
  {
    number: "02",
    icon: "/icons/apps/premiere-pro.png",
    iconAlt: "Adobe Premiere Pro",
    name: "Adobe Premiere Pro",
    tag: "Timeline flow, handoff, and exports",
    description:
      "Premiere sessions are about speed, organisation, and fewer avoidable mistakes. We work on sequence structure, multicam, Dynamic Link, exports, and the handoffs that keep projects moving cleanly.",
    audience:
      "Editors at any level who want to work faster, waste less time troubleshooting, and stop rediscovering the same things repeatedly.",
    ctaLabel: "Ask about Premiere"
  },
  {
    number: "03",
    icon: "/icons/apps/final-cut-pro.svg",
    iconAlt: "Final Cut Pro",
    name: "Final Cut Pro workflows",
    tag: "Libraries, handoff, and finishing",
    description:
      "Final Cut Pro sessions focus on getting from a clean edit to a clean finish: library structure, media management, roles, XML handoff, review exports, and moving projects into Resolve when the grade or delivery needs it.",
    audience:
      "Editors, videomakers, and small teams who like cutting in Final Cut Pro but need stronger workflow habits around delivery and collaboration.",
    ctaLabel: "Ask about Final Cut"
  },
  {
    number: "04",
    icon: "/icons/apps/after-effects.png",
    iconAlt: "Adobe After Effects",
    name: "After Effects",
    tag: "Animation and compositing basics",
    description:
      "After Effects gets easier once the structure makes sense. Sessions cover motion basics, compositing, pre-comps, expressions, and the points where After Effects and Premiere usually start wasting your time.",
    audience:
      "Editors moving into motion, motion designers filling technical gaps, and anyone who has been faking their way through expressions.",
    ctaLabel: "Ask about After Effects"
  },
  {
    number: "05",
    icon: "/icons/apps/photoshop.png",
    iconAlt: "Adobe Photoshop",
    name: "Adobe Photoshop",
    tag: "Retouching, masking, finishing",
    description:
      "Photoshop sessions focus on the detailed end of the image: retouching, masking, cleanup, compositing, and the small technical decisions that make stills feel properly finished.",
    audience:
      "Photographers, retouchers, designers, and content creators who want more control over the final image instead of relying on guesswork.",
    ctaLabel: "Ask about Photoshop"
  },
  {
    number: "06",
    icon: "/icons/apps/lightroom.png",
    iconAlt: "Adobe Lightroom",
    name: "Adobe Lightroom",
    tag: "Catalogues, grading, batch flow",
    description:
      "Lightroom sessions are about speed and consistency across whole bodies of work. We can focus on catalogue structure, colour workflow, batch editing, exports, and keeping large libraries manageable.",
    audience:
      "Photographers and image-makers who want a cleaner, faster workflow from ingest to export.",
    ctaLabel: "Ask about Lightroom"
  },
  {
    number: "07",
    icon: "/icons/apps/adobe-suite.png",
    iconAlt: "Adobe Creative Cloud",
    name: "Adobe Suite as a System",
    tag: "Connected suite-wide production",
    description:
      "This is for people using the Adobe suite all day but feeling the workflow is messier than it should be. We look at file structure, asset flow, shared libraries, Acrobat, Illustrator, InDesign, Media Encoder, and which tool should handle which part of the job.",
    audience:
      "Designers, creative directors, and production teams who live inside Adobe all day and suspect there is a smarter way to organise it all.",
    ctaLabel: "Ask about Adobe workflows"
  },
  {
    number: "08",
    icon: "/icons/apps/adobe-express-official.png",
    iconAlt: "Adobe Express",
    name: "Adobe Express",
    tag: "Fast branded content systems",
    description:
      "Adobe Express is best when speed and consistency matter at the same time. Sessions cover brand kits, templates, simple motion, and repeatable content systems that do not need a full design team behind them.",
    audience:
      "Marketing teams, content creators, educators, and small business owners who need to produce consistent, professional-looking content quickly and without a steep learning curve.",
    ctaLabel: "Ask about Express"
  }
];

const testimonials = [
  {
    quote:
      "Matteo's pace was just right for me. He was clear in his instructions, logical in his flow of teaching, and happy to answer my questions.",
    name: "Gwendolyn",
    context: "DaVinci Resolve · Melbourne",
    image: "/images/testimonials/gwendolyn.jpg"
  },
  {
    quote:
      "Matteo knows all the technical aspects of DaVinci Resolve very well, answered all my detailed questions, and communicated the concepts in an easily digestible manner. Happy to recommend him to others.",
    name: "Tim",
    context: "DaVinci Resolve · online",
    image: "/images/testimonials/tim.jpg"
  },
  {
    quote:
      "We covered the basics of multicam editing and he picked up the concepts quickly. Matteo tailored the session completely to the project I was working on.",
    name: "Diego",
    context: "DaVinci Resolve · music video project",
    image: "/images/testimonials/diego.jpg"
  },
  {
    quote:
      "Fantastic session. Matteo is very knowledgeable, very clear, and quick to diagnose exactly what was slowing me down in my workflow.",
    name: "Brian",
    context: "DaVinci Resolve · online",
    image: "/images/testimonials/brian.jpg"
  }
];

const tutoringSignals = [
  "One-on-one sessions",
  "Remote or in person in Fitzroy, Melbourne",
  "One-on-one sessions from $100/h",
  "Team and project blocks quoted on request"
];

const faqs = [
  {
    icon: "project",
    q: "Do I need my own footage or project to book a session?",
    a: "No, but it helps. Sessions are built around whatever you are actually working on, so bringing your own timeline, footage or catalogue makes the time far more useful. If you do not have a project in front of you, we work on supplied material instead."
  },
  {
    icon: "beginner",
    q: "Do you teach complete beginners?",
    a: "Yes. If you are opening Resolve, Premiere, Final Cut Pro or an Adobe app for the first time, we start from the interface, the basic language, and one small practical goal. You do not need to arrive already fluent."
  },
  {
    icon: "location",
    q: "Are sessions in person or online?",
    a: "Both. Face-to-face sessions run in Fitzroy at 204 Napier Street, Melbourne. Remote sessions run over Zoom, Teams or Google Meet and work well for screen sharing, live troubleshooting and focused workflow fixes."
  },
  {
    icon: "pricing",
    q: "What does a session cost?",
    a: "One-on-one sessions start from $100/h. Team or project blocks are quoted on request. Tell me what you are working on and what you want to walk away able to do, and I will suggest a simple structure before anything is booked."
  },
  {
    icon: "software",
    q: "Which software do you cover?",
    a: "DaVinci Resolve, Adobe Premiere Pro, Final Cut Pro workflows, After Effects, Photoshop, Lightroom, Adobe Express, and the rest of the Adobe suite as a connected production system. Resolve and Premiere are the most requested."
  },
  {
    icon: "team",
    q: "Can you train a whole team?",
    a: "Yes. Team and project blocks are quoted on request, and they usually work best when built around one real job the team is delivering rather than a generic curriculum."
  }
];

const siteUrl = `https://${SITE_CONFIG.primaryDomain}`;

const courseSchemas = tutoringAreas.map((area) => ({
  "@type": "Course",
  "@id": `${siteUrl}/training/#course-${area.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`,
  name: `${area.name} training in Melbourne and remote`,
  description: area.description,
  url: `${siteUrl}/training/`,
  inLanguage: "en-AU",
  teaches: area.tag,
  audience: {
    "@type": "Audience",
    audienceType: area.audience
  },
  provider: { "@id": `${siteUrl}/#person` },
  hasCourseInstance: [
    {
      "@type": "CourseInstance",
      courseMode: "onsite",
      location: {
        "@type": "Place",
        name: "Fitzroy, Melbourne",
        address: {
          "@type": "PostalAddress",
          streetAddress: "204 Napier Street",
          addressLocality: "Fitzroy",
          addressRegion: "VIC",
          postalCode: "3065",
          addressCountry: "AU"
        }
      }
    },
    {
      "@type": "CourseInstance",
      courseMode: "online"
    }
  ]
}));

const trainingSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${siteUrl}/training/#service`,
      name: "DaVinci Resolve and Adobe training",
      serviceType: "One-on-one DaVinci Resolve, Adobe Creative Cloud and post-production workflow training",
      url: `${siteUrl}/training/`,
      provider: { "@id": `${siteUrl}/#person` },
      areaServed: [
        { "@type": "City", name: "Melbourne" },
        { "@type": "State", name: "Victoria" },
        { "@type": "Country", name: "Australia" },
        "Remote"
      ],
      offers: {
        "@type": "Offer",
        price: "100",
        priceCurrency: "AUD",
        unitText: "hour",
        availability: "https://schema.org/InStock",
        url: `${siteUrl}/training/`
      },
      review: testimonials.map((item) => ({
        "@type": "Review",
        reviewBody: item.quote,
        author: { "@type": "Person", name: item.name }
      }))
    },
    ...courseSchemas,
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/training/#faq`,
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a }
      }))
    }
  ]
};

---

<BaseLayout
  title="DaVinci Resolve & Adobe Training in Melbourne and Remote | Matteo Curcio"
  description="One-on-one DaVinci Resolve, Premiere Pro, Final Cut Pro and Adobe training in Melbourne and online, taught by a working colourist and RMIT Adobe coach."
  path="/training"
  navSection="tutoring"
  ogImage="/images/og/matteo-curcio-tutoring-og.png"
  ogImageAlt="Matteo Curcio private tutoring social card for Resolve, Premiere, Final Cut Pro, Adobe workflows, and creative systems"
  structuredData={trainingSchema}
>
  <section class="services-head">
    <p class="kicker">DaVinci Resolve &amp; Adobe Training</p>
    <h1>DaVinci Resolve and Adobe training in Melbourne and remote</h1>
    <p class="services-head-standfirst">You've watched the tutorials. Something still isn't clicking.</p>
    <p>
      One-on-one DaVinci Resolve, Premiere Pro, Final Cut Pro workflow, After Effects, Photoshop and Lightroom training
      - built around your project, your workflow, and your specific gaps. Not a curriculum. Not a course. A conversation
      with someone who uses these tools on real jobs, in Melbourne or online.
    </p>
    <p>
      I grade and finish commercials for a living, and I coach Adobe Creative Cloud at RMIT University's Adobe Hub.
      Sessions come from that: current practice, real constraints, and the shortcuts that only show up on paid work.
    </p>
    <p>
      One-on-one sessions start from $100/h. Team training and project-based blocks are quoted once the scope is clear.
    </p>
    <div class="credibility-strip" aria-label="Tutoring booking details">
      {tutoringSignals.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="services-index services-card-grid tutoring-index" aria-label="Tutoring areas">
    {tutoringAreas.map((area) => (
      <article class="service-card">
        <div class="service-card-head">
          <span class="service-number tutoring-service-icon" aria-hidden="true">
            <img
              class="tutoring-app-icon"
              src={area.icon}
              alt={area.iconAlt}
              loading="lazy"
            />
          </span>
          <div class="service-card-title-group">
            <h2 class="service-name">{area.name}</h2>
            <p class="service-tag">{area.tag}</p>
          </div>
        </div>

        <div class="service-card-body">
          <p class="service-description">{area.description}</p>
          <p class="service-audience"><em>For {area.audience}</em></p>
          <p class="service-cta-wrap">
            <a class="button-link tutoring-card-button" href="#enquiry">
              {area.ctaLabel}
            </a>
          </p>
        </div>
      </article>
    ))}
  </section>

  <section class="tutoring-availability" aria-label="Tutoring availability">
    <div class="tutoring-availability-grid">
      <article class="tutoring-availability-card">
        <div class="tutoring-availability-media tutoring-map-frame">
          <iframe
            title="Map for 204 Napier Street, Fitzroy VIC 3065"
            src="https://www.google.com/maps?q=204+Napier+Street,+Fitzroy+VIC+3065&z=15&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <div class="tutoring-availability-body">
          <h2>In person</h2>
          <p>Face-to-face sessions are available in Fitzroy at 204 Napier Street.</p>
        </div>
      </article>

      <article class="tutoring-availability-card">
        <div class="tutoring-availability-media tutoring-remote-frame" aria-hidden="true">
          <div class="tutoring-remote-window">
            <div class="tutoring-remote-toolbar">
              <span></span><span></span><span></span>
            </div>
            <div class="tutoring-remote-screen">
              <p>Remote session</p>
              <div class="tutoring-remote-apps">
                <span>Zoom</span>
                <span>Teams</span>
                <span>Meet</span>
              </div>
            </div>
          </div>
        </div>
        <div class="tutoring-availability-body">
          <h2>Remote</h2>
          <p>Online sessions work well for screen-sharing, live troubleshooting, and focused workflow fixes.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="tutoring-testimonials" aria-label="Student reviews">
    <div class="tutoring-testimonial-grid">
      {testimonials.map((item) => (
        <article class="tutoring-quote">
          <img class="tutoring-quote-photo" src={item.image} alt={`${item.name} testimonial avatar`} loading="lazy" />
          <blockquote>{item.quote}</blockquote>
          <p class="tutoring-quote-meta">
            <span>{item.name}</span>
            <span>{item.context}</span>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="section training-contact-grid" id="enquiry" aria-label="Training questions and enquiry form">
    <div class="faq-section">
      <div class="page-head">
        <p class="kicker">FAQ</p>
        <h2>The questions that come up before booking.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>
              <span class={`faq-icon faq-icon-${item.icon}`} aria-hidden="true"></span>
              <span>{item.q}</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>

    <ServicesEnquiry
      variant="form"
      heading="Drop me an email"
      intro="Tell me what you are trying to learn, where you are stuck, and whether you prefer remote or in-person. No need to choose a package or pay anything before we have worked out what would actually help."
      buttonLabel="Send message"
      subject="Training enquiry"
    />
  </section>
</BaseLayout>
