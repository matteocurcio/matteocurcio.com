---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { postsByTopic } from "../../lib/posts";

const groups = postsByTopic;
---

<BaseLayout
  title="Blog | Colour, Finishing, Workflow & Tools | Matteo Curcio"
  description="Technical writing on colour grading, finishing and delivery, on production workflow and infrastructure, and on the tools built to solve specific problems."
  path="/blog"
>
  <section class="page-head">
    <h1>Technical notes on post-production, tools, and process.</h1>
  </section>

  {groups.map((group) => (
    <section class="section blog-topic" aria-label={group.title}>
      <div class="blog-topic-head">
        <h2>{group.title}</h2>
        <p>{group.blurb}</p>
      </div>

      <div class="blog-grid">
        {group.posts.map((post) => (
          <PostCard
            slug={post.slug}
            title={post.title}
            date={post.date}
            excerpt={post.excerpt}
            cover={post.cover}
            coverAlt={post.coverAlt}
          />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
