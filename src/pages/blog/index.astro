---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { technicalPosts } from "../../lib/posts";

const posts = technicalPosts;
---

<BaseLayout title="Blog | Matteo Curcio" path="/blog">
  <h1>Technical notes on post-production, tools, and process.</h1>

  <div class="section blog-grid">
    {posts.map((post) => (
      <PostCard
        slug={post.slug}
        title={post.title}
        date={post.date}
        excerpt={post.excerpt}
        cover={post.cover}
        coverAlt={post.coverAlt}
      />
    ))}
  </div>
</BaseLayout>
